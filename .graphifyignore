# Local Graphify config: keeps generated, vendored, and noisy paths out of
# `graphify .` so the graph maps source, not build output. Output is gitignored.

# Build / generated output
dist/
build/
reports/
artifacts/
graphify-out*/

# Dependencies / vendored
node_modules/
coverage/

# Local tool state
.copilot/

# Version control + environment
.git/
.venv/
__pycache__/
*.pyc

# Noise files
*.log
*.tmp
*.lock
package-lock.json

# Binary and media files
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mp3
*.docx
*.xlsx
