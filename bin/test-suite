#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

mkdir -p reports/state reports/logs
docker compose build
docker compose up -d --wait gateway-api

cleanup() {
  docker compose down --volumes --remove-orphans
}
trap cleanup EXIT

./bin/punch run all --collect-logs
